{
    "name": "ergnuor/sphinx-config",
    "type": "library",
    "description": "A PHP Sphinx config helper",
    "keywords": ["sphinx", "config", "helper"],
    "license": "Apache-2.0",
    "authors": [{"name": "Denis Tarasov", "email": "brokeneye@gmail.com"}],
    "support": {
        "email": "brokeneye@gmail.com"
    },
    "require": {
        "php": "^8.4.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs:check": "php-cs-fixer check --diff --verbose",
        "cs:fix": "php-cs-fixer fix --diff --verbose"
    },
    "autoload": {
        "psr-4": {
            "Ergnuor\\SphinxConfig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ergnuor\\SphinxConfig\\Tests\\": "tests/SphinxConfig"
        }
    }
}
